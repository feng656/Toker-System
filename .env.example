# 数据库（PostgreSQL）
DATABASE_URL=postgresql+psycopg://用户:密码@主机:5432/库名
# Redis（可选，用于缓存/任务状态）
REDIS_URL=redis://:密码@主机:6379/0
# 对象存储 MinIO（存素材图片/视频）
MINIO_ENDPOINT=主机:9000
MINIO_ACCESS_KEY=访问密钥
MINIO_SECRET_KEY=密钥
MINIO_BUCKET=tuoke
MINIO_SECURE=false
# 登录令牌签名密钥（自行生成一串随机字符）
JWT_SECRET=请替换为随机长字符串
JWT_EXPIRE_HOURS=72
# 大模型 API Key（文案生成/评论判断）
DEEPSEEK_KEY=
GLM_KEY=
KIMI_KEY=
# 企业微信群机器人（线索提醒，可留空）
WECOM_WEBHOOK=
