# 生产数据库必须使用PostgreSQL。平台环境请使用已审批的托管实例，不在沙箱自启数据库。
DATABASE_URL=postgresql+psycopg://tuoke:replace-password@postgres-host:5432/tuoke
APP_ENV=production
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=
# 生产禁止演示模式；仅开发/验收时可显式设置APP_ENV=development和DEMO_MODE=true
DEMO_MODE=false
# API进程关闭调度，由单独worker启动。不要多个worker共用APScheduler。
SCHEDULER_ENABLED=false
# 对象存储：私有桶，截图/素材不公开；浏览器通过签名接口访问
MINIO_ENDPOINT=object-store-host:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=tuoke
MINIO_SECURE=false
UPLOAD_MAX_BYTES=10485760
# OpenAI兼容JSON接口；最多三个服务依次故障转移，每次调用记ai_jobs
LLM_PROVIDERS=[]
LLM_TIMEOUT=30
# LLM_PROVIDERS示例（自行填入，不提交真实key）:
# [{"name":"primary","base_url":"https://your-ai-host/v1","model":"your-model","key":"your-key"}]
OCR_BACKEND=tesseract
OCR_LANG=chi_sim+eng
OCR_TIMEOUT=30
OCR_THRESHOLD=0.85
# OCR_BACKEND=http时填写受信OCR服务的multipart接口，契约见docs/ADAPTERS.md
OCR_ENDPOINT=
OCR_TOKEN=
WECOM_WEBHOOK=
CRM_WEBHOOK=
CRM_TOKEN=
OUTBOX_MAX_ATTEMPTS=5
# 一期以人工发布回填为准，实验适配默认关闭
OFFICIAL_PUBLISH_ENABLED=false
BROWSER_ENABLED=false
BROWSER_ADAPTER_URL=
BROWSER_ADAPTER_TOKEN=
# Windows可使用C:/toker-data/...；Linux使用绝对路径或相对项目根路径
BROWSER_STATE_DIR=var/browser_state
VIDEO_OUTPUT_DIR=var/video_out
UPLOAD_DIR=var/uploads
# 初始化管理员时设置一次；生产不自动创建默认密码
BOOTSTRAP_ADMIN_PASSWORD=

# 二期安全策略：自动注册默认关闭；invite模式需至少16字符随机邀请码，最低权限sales
AUTO_REGISTER_MODE=off
REGISTER_INVITE_CODE=
LOGIN_WINDOW_SECONDS=60
LOGIN_IP_LIMIT=30
LOGIN_ACCOUNT_LIMIT=10
LOGIN_CHALLENGE_AFTER=3
LOGIN_MAX_INFLIGHT=4
# Fernet密钥：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 必须妥善备份；更换密钥后旧会话须重新扫码。不要与JWT_SECRET复用。
SESSION_ENCRYPTION_KEY=
# 部署人员配置精确主机白名单；AI端点、受信浏览器适配器不能由UI任意出站。
ADAPTER_ALLOWED_HOSTS=
MEDIA_ALLOWED_HOSTS=
# UI仅可引用TOKER_AI_KEY_*环境变量，避免读取数据库密码等无关环境秘密。
TOKER_AI_KEY_TEXT=
TOKER_AI_KEY_VIDEO=
# 仅单副本worker运行；任务已入队/已人工批准才处理；结果不确定不自动重发。
PHASE2_WORKER_ENABLED=false
# 评论/私信发送默认关闭；只对自有/获准范围，遵守平台规则。
AUTOMATION_ENABLED=false
AUTOMATION_INTERVAL_SECONDS=60
AUTOMATION_DAILY_LIMIT=50
