# 生产数据库必须使用PostgreSQL。平台环境请使用已审批的托管实例，不在沙箱自启数据库。
DATABASE_URL=postgresql+psycopg://tuoke:replace-password@postgres-host:5432/tuoke
APP_ENV=production
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=
# 生产禁止演示模式；仅开发/验收时可显式设置APP_ENV=development和DEMO_MODE=true
DEMO_MODE=false
# 仅 DEMO_MODE=true 时必填，至少10位；仓库不保存真实口令
DEMO_SEED_PASSWORD=
# API进程关闭调度，由单独worker启动。不要多个worker共用APScheduler。
SCHEDULER_ENABLED=false
# 对象存储：私有桶，截图/素材不公开；浏览器通过签名接口访问
MINIO_ENDPOINT=object-store-host:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=tuoke
MINIO_SECURE=false
UPLOAD_MAX_BYTES=10485760
# OpenAI兼容JSON接口；最多三个服务依次故障转移，每次调用记ai_jobs
LLM_PROVIDERS=[]
# 平台网关四平台长文实测约 60s，建议不小于 120
LLM_TIMEOUT=120
# LLM_PROVIDERS示例（自行填入，不提交真实key）:
# [{"name":"primary","base_url":"https://your-ai-host/v1","model":"your-model","key":"your-key"}]
# 平台模型网关（OpenAI兼容）：填 PIOS_MODEL_KEY 后，LLM_PROVIDERS 留空即自动接入，
# 主模型失败自动切备用模型。key 用 `pios model key` 自助签发（mgk- 开头），不要提交仓库。
PIOS_GATEWAY_URL=https://devhub.supiedt.com/api/v1/model-gateway/v1
PIOS_MODEL_KEY=
LLM_MODEL=moonshotai/kimi-k3.1-pro
LLM_FALLBACK_MODEL=qwen/qwen3.8-2.4t-a95b
# 平台视频生成：PIOS_API_URL 形如 https://host/api/v1，PIOS_TOKEN 为平台访问令牌。
# 未配置时 /video/generate 返回 503，不生成占位视频冒充真实成片。
PIOS_API_URL=
PIOS_TOKEN=
VIDEO_PROVIDER=pios
VIDEO_MODEL=MiniMax-H3
VIDEO_RESOLUTION=2K
# 主模型上游 502 时自动降级一次；豆包 mini 的 t2v 只接受 720P。
VIDEO_FALLBACK_MODEL=doubao-seedance-2-0-mini-260615
VIDEO_FALLBACK_RESOLUTION=720P
VIDEO_ASPECT_RATIO=9:16
VIDEO_DURATION_SEC=5
VIDEO_POLL_INTERVAL=10
VIDEO_TIMEOUT=900
VIDEO_WATERMARK=true
OCR_BACKEND=tesseract
OCR_LANG=chi_sim+eng
OCR_TIMEOUT=30
OCR_THRESHOLD=0.85
# OCR_BACKEND=http时填写受信OCR服务的multipart接口，契约见docs/ADAPTERS.md
OCR_ENDPOINT=
OCR_TOKEN=
WECOM_WEBHOOK=
CRM_WEBHOOK=
CRM_TOKEN=
OUTBOX_MAX_ATTEMPTS=5
# 一期以人工发布回填为准，实验适配默认关闭
OFFICIAL_PUBLISH_ENABLED=false
BROWSER_ENABLED=false
BROWSER_ADAPTER_URL=
BROWSER_ADAPTER_TOKEN=
# 可选：已接入扫码平台code，以逗号分隔，例如douyin。
# 留空兼容旧适配器，由服务实际响应决定；预置目录不等于已接通。
BROWSER_LOGIN_PLATFORMS=
# 可选内置适配器使用平台官方登录页，不伪造二维码、不导出Cookie。
# BROWSER_ADAPTER_URL=http://127.0.0.1:8400 时启动；需要容器内 Chromium。
LOGIN_ADAPTER_PORT=8400
CHROMIUM_PATH=/usr/bin/chromium
LOGIN_QR_TTL_SECONDS=120
LOGIN_SESSION_TTL_HOURS=168
LOGIN_MAX_BROWSER_SESSIONS=4
# Windows可使用C:/toker-data/...；Linux使用绝对路径或相对项目根路径
BROWSER_STATE_DIR=var/browser_state
VIDEO_OUTPUT_DIR=var/video_out
UPLOAD_DIR=var/uploads
# 初始化管理员时设置一次；生产不自动创建默认密码
BOOTSTRAP_ADMIN_PASSWORD=

# 二期安全策略：自动注册默认关闭；invite模式需至少16字符随机邀请码，最低权限sales
AUTO_REGISTER_MODE=off
REGISTER_INVITE_CODE=
LOGIN_WINDOW_SECONDS=60
LOGIN_IP_LIMIT=30
LOGIN_ACCOUNT_LIMIT=10
LOGIN_CHALLENGE_AFTER=3
LOGIN_MAX_INFLIGHT=4
# Fernet密钥：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 必须妥善备份；更换密钥后旧会话须重新扫码。不要与JWT_SECRET复用。
SESSION_ENCRYPTION_KEY=
# 部署人员配置精确主机白名单；AI端点、受信浏览器适配器不能由UI任意出站。
ADAPTER_ALLOWED_HOSTS=
# 发布适配器只从这些主机下载已公开授权的视频素材，并限制单文件大小。
MEDIA_ALLOWED_HOSTS=
MEDIA_MAX_BYTES=209715200
# 已上传并填好文案、等待人工确认的发布草稿在适配器内存中的保留秒数。
PUBLISH_DRAFT_TTL_SECONDS=1800
# UI仅可引用TOKER_AI_KEY_*环境变量，避免读取数据库密码等无关环境秘密。
TOKER_AI_KEY_TEXT=
TOKER_AI_KEY_VIDEO=
# 仅单副本worker运行；任务已入队/已人工批准才处理；结果不确定不自动重发。
PHASE2_WORKER_ENABLED=false
# 评论/私信发送默认关闭；只对自有/获准范围，遵守平台规则。
AUTOMATION_ENABLED=false
AUTOMATION_INTERVAL_SECONDS=60
AUTOMATION_DAILY_LIMIT=50
